# AI mode: mock | qwen | hybrid
# qwen = fail visibly when the online API fails
# hybrid = prefer Qwen, then fall back to deterministic/local demo logic
AI_MODE=hybrid
AI_PROVIDER=qwen
BOM_AI_ENABLED=true

# Local/LAN service binding. Use 0.0.0.0 to allow other LAN devices.
DREAMHOUSE_HOST=0.0.0.0
DREAMHOUSE_PORT=3000
DREAMHOUSE_PORTS=3000

# STEP 3 touch demo: preload the prepared Pascal SceneGraph and play a
# front-end-only generation experience. Set false only when a real 3D job
# service is implemented.
NEXT_PUBLIC_DEMO_3D_MODE=true

# Alibaba Cloud Model Studio / Bailian
# Keep the real key in .env.local or Vercel Environment Variables. Never expose it to NEXT_PUBLIC_*.
QWEN_API_KEY=

# Recommended workspace-specific Beijing URLs. Replace YOUR_WORKSPACE_ID.
QWEN_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Models requested by this project
QWEN_LAYOUT_MODEL=qwen3.8-flash
QWEN_BOM_MODEL=qwen3.8-flash
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# Optional STEP 4 override; leave empty to use QWEN_IMAGE_MODEL.
QWEN_INTERIOR_IMAGE_MODEL=
# Optional fixed output size. Leave empty to derive the same aspect ratio as the capture.
QWEN_IMAGE_SIZE=

# Request timeouts in milliseconds
QWEN_TEXT_TIMEOUT_MS=60000
QWEN_IMAGE_TIMEOUT_MS=1800000

# Optional construction-side media
NEXT_PUBLIC_PRINTER_VIDEO=
NEXT_PUBLIC_ROBOT_VIDEO=
NEXT_PUBLIC_SITE_VIDEO=

# 8765 机械臂只读监控（仅服务端读取）
ROBOT_MONITOR_MODE=demo
ROBOT_MONITOR_BASE_URL=
NEXT_PUBLIC_SITE_CAMERA_URL=

# STEP 6 monitoring modes. These flags are server-only and are shown in the UI.
# Set to true only for local demonstration; real credentials stay server-side.
DEMO_PRINTER_MODE=true
DEMO_ROBOT_MODE=true
DEMO_CAMERA_MODE=true
BAMBU_PRINTER_IP=
BAMBU_DEVICE_ID=
BAMBU_ACCESS_CODE=
BAMBU_MODEL=
FFMPEG_PATH=
ROBOT_API_ENDPOINT=
ROBOT_ACCESS_TOKEN=
ROBOT_MODEL=

# Optional image persistence hook; Qwen image result URLs are temporary (normally 24h).
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
