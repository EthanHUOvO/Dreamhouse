COPY v2/step3-3d/bedroom-scene-validation.ts /app/lib/ai/bedroom-scene-validation.ts
COPY v2/step3-3d/bedroom-source-furniture.ts /app/lib/ai/bedroom-source-furniture.ts
COPY v2/step2-edit/floorplan-edit-intent.ts /app/lib/ai/floorplan-edit-intent.ts
