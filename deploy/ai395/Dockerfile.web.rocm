COPY v2/step5-bom/qwen-layout-agent.ts /app/lib/ai/qwen-layout-agent.ts
COPY v2/step2-edit/structure-edit-agent.ts /app/lib/ai/structure-edit-agent.ts
COPY qwen-floorplan-import.ts /app/lib/ai/qwen-floorplan-import.ts
COPY v2/step3-3d/model3d-vision-input.ts /app/lib/ai/model3d-vision-input.ts
COPY v2/step3-3d/svg-version.ts /app/lib/ai/svg-version.ts
