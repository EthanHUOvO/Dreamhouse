# Incremental offline build on the verified Step3 save/Step4 binding release.
FROM ideal-home-local:web-edit-save-20261022
COPY TouchCustomerPortal.tsx /app/components/customer/TouchCustomerPortal.tsx
COPY v2/step3-3d/svg-edit-geometry.ts /app/lib/ai/svg-edit-geometry.ts
COPY v2/step3-3d/bedroom-edit-geometry.ts /app/lib/ai/bedroom-edit-geometry.ts
COPY v2/step3-3d/bedroom-scene-validation.ts /app/lib/ai/bedroom-scene-validation.ts
COPY v2/step3-3d/bedroom-source-furniture.ts /app/lib/ai/bedroom-source-furniture.ts
COPY v2/step2-edit/floorplan-edit-intent.ts /app/lib/ai/floorplan-edit-intent.ts
COPY v2/step2-edit/svg-edit-route.ts /app/app/api/ai/svg-edit/route.ts
RUN npm run build
