 }
+
+/* Keep the complete model legible while its authored geometry stays unchanged. */
+.step3-slide .touch-pascal-host { flex:1 1 0; height:auto; min-height:230px; }
+.step3-slide .model-action-toolbar { position:sticky; top:0; z-index:45; background:#fff; padding:8px 0; }
+.overview-presentation-controls { position:absolute; top:10px; right:10px; z-index:40; display:flex; flex-wrap:wrap; gap:6px; }
+.overview-presentation-controls button { background:rgba(255,255,255,.94); border:1px solid #d4dbe1; border-radius:7px; padding:6px 10px; color:#304252; font-size:12px; }
+.overview-presentation-controls button.active { background:#edf5f6; border-color:#6593a1; }
+.overview-presentation-note { position:absolute; left:10px; bottom:10px; z-index:30; padding:5px 8px; border-radius:6px; background:rgba(255,255,255,.88); color:#546372; font-size:12px; }
+@media(max-width:800px) { .step3-slide .touch-pascal-host { flex-basis:260px; min-height:260px; } }
+
+.step3-slide .pascal-panel > .customer-result-note { margin:0 0 6px; padding:6px 10px; font-size:12px; }
+.step3-slide .panel-inline-head { gap:8px; margin-bottom:6px; }
+.step3-slide .panel-inline-head h3 { margin:0; font-size:20px; }
+.step3-slide .panel-inline-head p { margin:4px 0; font-size:12px; }
+.step3-slide .model-action-toolbar button { padding:6px 10px; min-height:34px; font-size:12px; }
+.step3-slide .pascal-view-tabs button { padding:6px 12px; min-height:34px; font-size:14px; }
+
+.pascal-viewer-shell.is-overview-expanded { position:fixed; inset:16px; height:auto; min-height:0; z-index:150; background:#edf0f3; border:1px solid #d5dce3; border-radius:12px; box-shadow:0 20px 80px #14253655; }
+
+/* The saved captures and style controls must not shrink the render to a thumbnail. */
+.touch-customer-page .render-touch-grid { display:block; overflow:auto; }
+.touch-customer-page .render-main-panel { display:block; height:auto; overflow:visible; }
+.touch-customer-page .interior-result-wrap { grid-template-rows:auto minmax(260px,36vh); }
+.touch-customer-page .source-capture-preview { min-height:300px; grid-template-rows:minmax(260px,36vh); }
+.touch-customer-page .render-caption { display:grid; grid-template-columns:minmax(220px,.8fr) minmax(320px,1fr); gap:12px 24px; margin-top:16px; }
+.touch-customer-page .render-caption > b { grid-column:1/-1; font-size:18px; }
+@media(max-width:760px) {
+  .touch-customer-page .render-caption { grid-template-columns:minmax(0,1fr); }
+  .touch-customer-page .interior-result-head { flex-wrap:wrap; }
+}
